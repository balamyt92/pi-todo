{
  "name": "pi-todo",
  "version": "1.1.0",
  "description": "Живой todo-виджет для Pi: панель задач над редактором со свёрнутым и развёрнутым режимами (/todos-toggle-widget)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "task-list",
    "widget"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "index.ts",
    "types.ts",
    "invariants.ts",
    "graph.ts",
    "reducer.ts",
    "store.ts",
    "replay.ts",
    "response.ts",
    "selectors.ts",
    "format.ts",
    "overlay.ts",
    "tool.ts",
    "commands.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
